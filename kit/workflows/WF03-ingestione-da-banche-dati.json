    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "6618b57c-0952-51c1-b3ae-4125dc1d8822",
              "name": "fonte",
              "value": "internet_archive",
              "type": "string"
            },
            {
              "id": "72898a34-2265-5d2b-9ab9-3d0402b26523",
              "name": "ricerca",
              "value": "garibaldi AND mediatype:texts AND language:ita",
              "type": "string"
            },
            {
              "id": "daa49cb3-93de-5b6e-8ac4-99ffe44f1d52",
              "name": "ricerca_sparql",
              "value": "SELECT ?item ?itemLabel ?data WHERE { ?item wdt:P31 wd:Q178561; wdt:P585 ?data. FILTER(YEAR(?data) >= 1848 && YEAR(?data) <= 1849) SERVICE wikibase:label { bd:serviceParam wikibase:language \"it\". } } LIMIT 20",
              "type": "string"
            },
            {
              "id": "f99ab41c-15d5-5569-84df-df25fe0ae441",
              "name": "massimo_risultati",
              "value": 10,
              "type": "number"
            },
            {
              "id": "2e658c65-f756-5825-8310-cabdab1dbc4c",
              "name": "chiave_europeana",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
