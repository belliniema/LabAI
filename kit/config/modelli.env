# Modelli del laboratorio (CLAUDE.md §4, ADR-002).
# Il launcher sceglie il profilo in base alla RAM; lo studente puo' forzarlo dal pannello.
# NON cambiare EMBEDDING_* durante il semestre: obbliga a rifare tutti gli indici.

KIT_VERSION=0.1.0

EMBEDDING_MODEL=embeddinggemma:300m
EMBEDDING_DIM=768

STANDARD_RAM_MIN_GB=16
STANDARD_LLM=qwen3.5:4b
STANDARD_NUM_CTX=16384
STANDARD_CORPUS_MAX=40

LEGGERO_RAM_MIN_GB=8
LEGGERO_LLM=qwen3.5:2b
LEGGERO_NUM_CTX=8192
LEGGERO_CORPUS_MAX=20

# Modelli derivati creati dal launcher (Modelfile.*.tmpl)
MODEL_ESTRAZIONE=lab-estrazione
MODEL_RISPOSTA=lab-risposta
TEMPERATURA_ESTRAZIONE=0.1
TEMPERATURA_RISPOSTA=0.3
