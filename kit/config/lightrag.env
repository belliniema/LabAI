# Impostazioni comuni di LightRAG v1.5.7 (ADR-005). Nomi verificati in env.example del tag.
# I valori che dipendono dal profilo sono in profili/<profilo>.env.
# I segreti (LIGHTRAG_API_KEY) arrivano da .env, generato dal launcher.

WEBUI_TITLE='Laboratorio IA · grafo personale'
WEBUI_DESCRIPTION='Grafo di conoscenza del tuo corpus'
WHITELIST_PATHS=/health

LLM_BINDING=ollama
LLM_BINDING_HOST=http://host.docker.internal:11434
LLM_MODEL=lab-risposta
EXTRACT_LLM_MODEL=lab-estrazione
QUERY_LLM_MODEL=lab-risposta
KEYWORD_LLM_MODEL=lab-estrazione

OLLAMA_LLM_THINK=false
EXTRACT_OLLAMA_LLM_THINK=false
KEYWORD_OLLAMA_LLM_THINK=false

EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
EMBEDDING_MODEL=embeddinggemma:300m
EMBEDDING_DIM=768
EMBEDDING_TOKEN_LIMIT=2048
OLLAMA_EMBEDDING_NUM_CTX=2048
EMBEDDING_FUNC_MAX_ASYNC=1
EMBEDDING_BATCH_NUM=8
EMBEDDING_TIMEOUT=300

SUMMARY_LANGUAGE=Italian
ENTITY_EXTRACTION_USE_JSON=true
ENTITY_TYPE_PROMPT_FILE=entity_type_storico.yml
PROMPT_DIR=/app/data/prompts
ENABLE_LLM_CACHE=false
RERANK_BINDING=null

MAX_PARALLEL_INSERT=1
MAX_PARALLEL_ANALYZE=1
TIMEOUT=1800

LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

LOG_LEVEL=INFO
